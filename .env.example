APP_ENV=development
DATABASE_URL=postgresql+psycopg://maternal:change-me@localhost:5432/maternal
COOKIE_SECURE=false
# Add these privately to Vercel Production, then redeploy. Never commit real values.
RESEND_API_KEY=
EMAIL_FROM=
APP_PUBLIC_URL=
CRON_SECRET=
# Public research model is selected by default. Optional token may increase provider quota.
RISK_MODEL_PROVIDER=huggingface
HF_TOKEN=
# Set RISK_MODEL_PROVIDER=disabled to block research inference.
# A custom REST provider instead requires RISK_MODEL_PROVIDER=rest plus all three:
RISK_MODEL_URL=
RISK_MODEL_VERSION=
RISK_MODEL_CARD_URL=
RISK_MODEL_TOKEN=
# Create an administrator using: python -m backend.create_admin
